{
  "name": "amazon-order-scraper",
  "version": "1.0.0",
  "description": "Scrape Amazon order history with itemized details, prices, and transactions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "amazon-scraper": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "amazon",
    "order",
    "scraper",
    "playwright",
    "mcp",
    "monarch"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eshaffer321/amazon-monarch-sync.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/eshaffer321/amazon-monarch-sync#readme",
  "bugs": {
    "url": "https://github.com/eshaffer321/amazon-monarch-sync/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
